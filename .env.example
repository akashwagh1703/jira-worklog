# Frontend (Vite) configuration. Copy to `.env.local` for local dev or
# `.env.production` for prod builds. All variables MUST be prefixed with
# VITE_ to be exposed to the browser bundle.

# Branding shown in the title bar, sidebar, and login page.
VITE_APP_NAME="ESDS Worklog Dashboard"
VITE_APP_TAGLINE="Employee Analytics Dashboard"

# Public path the SPA is served from. Must match:
#   - vite.config.js `base`
#   - public/.htaccess `RewriteBase` (Apache only)
#   - the URL prefix on your web server
# Trailing slash REQUIRED.
VITE_APP_BASE_PATH="/famrut-team-logs/logs/"

# PHP backend root (the directory that contains proxy.php and projects.php).
# Do NOT include a trailing slash.
VITE_API_BASE_URL="https://dev.famrut.com/famrut-team-logs/api"

# Phase 2 feature flag. When set to "true":
#   - Management users fetch all data via the backend (issues.php / worklogs.php /
#     users.php) using the system Jira service account configured in
#     jira-api/jira_config.php — they do NOT need to enter Jira API tokens.
#   - Employees keep using their own credentials via proxy.php (until Phase 3 SSO).
# When set to "false" (default), the app keeps the legacy per-user-token flow.
VITE_USE_BACKEND_JIRA="false"

# -----------------------------------------------------------------------------
# Phase 3 — Backend env vars (NOT prefixed with VITE_; these go in the PHP
# host's environment, not the Vite build). Below is documented here for clarity.
#
# Set them via Apache `SetEnv`, your hosting panel, or a phpdotenv loader. See
# SSO_SETUP.md for tested provider-specific presets (Google / Microsoft /
# Atlassian).
# -----------------------------------------------------------------------------
#
# OIDC_ENABLED=true|false
# OIDC_CLIENT_ID=...
# OIDC_CLIENT_SECRET=...
# OIDC_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
# OIDC_TOKEN_URL=https://oauth2.googleapis.com/token
# OIDC_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo
# OIDC_REDIRECT_URI=https://dev.famrut.com/famrut-team-logs/api/auth/callback.php
# OIDC_SCOPES="openid email profile"
# OIDC_ALLOWED_DOMAINS=esds.co.in,esds.net.in
# OIDC_INITIAL_ADMIN=admin@esds.co.in
# APP_URL=/famrut-team-logs/logs/
#
# AUTH_REQUIRED=false   # Set true after SSO is fully rolled out.
