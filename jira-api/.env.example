# Copy to `.env` or `.env.local` in this directory (jira-api/).
# Values here are loaded by db.php on every request (see db.php _loadDotenv).

# -----------------------------------------------------------------------------
# Production example — SPA: https://dev.famrut.com/esds-worklogs/login
# API: https://dev.famrut.com/esds-worklogs/jira-api/
# (Usually set via Apache SetEnv instead; see SSO_SETUP.md.)
# -----------------------------------------------------------------------------
# OIDC_REDIRECT_URI=https://dev.famrut.com/esds-worklogs/jira-api/auth/callback.php
# APP_URL=/esds-worklogs/
#   OR full URL: APP_URL=https://dev.famrut.com/esds-worklogs/

# -----------------------------------------------------------------------------
# Local dev with Vite (npm run php-api in one terminal, npm run dev in another)
# -----------------------------------------------------------------------------
# Frontend .env.local should set:
#   VITE_API_BASE_URL=http://localhost:5173/esds-worklogs/jira-api
# Register this exact redirect URI with your OAuth client:
#   http://localhost:5173/esds-worklogs/jira-api/auth/callback.php
# And point APP_URL at the Vite dev server so post-login redirect works:
#   APP_URL=http://localhost:5173/esds-worklogs/

# -----------------------------------------------------------------------------
# Phase 3 — Atlassian (Jira Cloud SSO — same account as *.atlassian.net)
# -----------------------------------------------------------------------------
# OIDC_AUTH_URL=https://auth.atlassian.com/authorize
# OIDC_TOKEN_URL=https://auth.atlassian.com/oauth/token
# OIDC_USERINFO_URL=https://api.atlassian.com/me
# OIDC_SCOPES=read:me
# Add User Identity API + read:me in the Atlassian developer console.

# -----------------------------------------------------------------------------
# Phase 3 — OpenID Connect (Google example; see ../SSO_SETUP.md for others)
# -----------------------------------------------------------------------------
OIDC_ENABLED=true
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
OIDC_TOKEN_URL=https://oauth2.googleapis.com/token
OIDC_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo
OIDC_REDIRECT_URI=http://localhost:5173/esds-worklogs/jira-api/auth/callback.php
OIDC_SCOPES=openid email profile
# OIDC_ALLOWED_DOMAINS=yourcompany.com
# OIDC_INITIAL_ADMIN=you@yourcompany.com

APP_URL=http://localhost:5173/esds-worklogs/

# Flip to true when all users should authenticate (APIs use requireAuth()).
AUTH_REQUIRED=false

# Optional: SQLite for users/audit (recommended for local SSO testing).
# DB_DSN=sqlite:D:/path/to/jira-worklog/jira-api/data.db
