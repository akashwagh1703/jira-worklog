# Block direct web access to sensitive files in the api directory.
# .php endpoints are still served normally; only data files are blocked.

<FilesMatch "\.(json|env|tmp|log|db|sqlite|sqlite3)$">
  Require all denied
</FilesMatch>

# Block the cache directory entirely (file-based response cache).
RedirectMatch 403 ^/.*/cache/.*$

# Block the migration / smoke test scripts from web access (CLI-only).
<FilesMatch "^(migrate|smoke_phase\d+)\.php$">
  Require all denied
</FilesMatch>
